PORT=3001
DATABASE_URL=postgresql://servicebook:servicebook@localhost:5432/servicebook

# Used by `npm test` (Vitest + Supertest). Wiped between tests — never point it at real data.
TEST_DATABASE_URL=postgresql://servicebook:servicebook@localhost:5432/servicebook_test

# Better Auth. Generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated. The Vite dev server proxies /api, so only it needs listing in dev.
TRUSTED_ORIGINS=http://localhost:5173

# Staff member provisioned by `npm run prisma:seed -w @servicebook/backend`.
# More staff members: `npm run staff:create -w @servicebook/backend -- <email> <password> [name]`.
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_STAFF_NAME=

# Production only: the built admin panel served by Express (ADR-0001).
# Defaults to ../admin-panel/dist relative to this app when NODE_ENV=production.
ADMIN_PANEL_DIST=

# Test-only: `npm run test:e2e` sets this to switch off Better Auth's sign-in rate limit.
# Never set it in production.
# AUTH_RATE_LIMIT_DISABLED=true

# Error tracking. Leave unset to disable (no-op).
SENTRY_DSN=

# Used by `npm run test:e2e` (Playwright). Wiped on every run — never point it at real data.
E2E_DATABASE_URL=postgresql://servicebook:servicebook@localhost:5432/servicebook_e2e
