generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Better Auth ---
// A User is a staff member (see GLOSSARY.md); the table keeps Better Auth's name.

model User {
  id            String            @id
  name          String
  email         String
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      Session[]
  accounts      Account[]
  logEntries    ServiceLogEntry[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- Domain ---

/// A person or business that brings devices in for service (see GLOSSARY.md).
model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  email     String?
  address   String?
  facebook  String?
  /// The record's ID in the old Firebase app; makes re-imports idempotent.
  legacyId  String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  devices   Device[]
  services  Service[]

  @@index([name])
  @@map("customer")
}

/// An entry in the shop's price list: a type of work with a default price (see GLOSSARY.md).
model Action {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  /// Default price in whole RSD.
  price     Int
  /// The record's ID in the old Firebase app; makes re-imports idempotent.
  legacyId  String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  /// A referenced action cannot be deleted.
  lines     ServiceLine[]

  @@index([name])
  @@map("action")
}

/// A physical item that can be serviced or sold, owned by one customer or generic (see GLOSSARY.md, ADR-0004).
model Device {
  id           String          @id @default(uuid()) @db.Uuid
  /// Optional: cables and other accessories often have none. Shown before the model (see GLOSSARY.md).
  manufacturer String?
  model        String
  /// Not unique: legacy data has duplicates and placeholders.
  serialNumber String?
  /// Facts about the device itself, not its condition at intake (that belongs in the service Log).
  description  String?
  /// Null for a generic device. A customer who still owns devices cannot be deleted.
  ownerId      String?         @db.Uuid
  owner        Customer?       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  /// The record's ID in the old Firebase app; makes re-imports idempotent.
  legacyId     String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  services     ServiceDevice[]
  /// A device sold on a service cannot be deleted.
  saleLines    ServiceLine[]

  @@index([manufacturer, model])
  @@index([ownerId])
  @@map("device")
}

/// Where a service is in its lifecycle (see GLOSSARY.md).
enum Status {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELLED
}

/// One customer's visit with one or more devices on a given date (see GLOSSARY.md, ADR-0003).
model Service {
  id          String            @id @default(uuid()) @db.Uuid
  /// With `sequence`, the service number `YYYY-NNNN`: the year of the service's date when it was created.
  year        Int
  /// Allocated from `ServiceNumberCounter` inside the creation transaction; never reused.
  sequence    Int
  /// Identifies the service on its public link; never the UUID or the service number.
  publicToken String            @unique
  date        DateTime          @db.Date
  description String?
  status      Status            @default(RECEIVED)
  /// A customer with services cannot be deleted.
  customerId  String            @db.Uuid
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  devices     ServiceDevice[]
  lines       ServiceLine[]
  log         ServiceLogEntry[]
  /// The record's ID in the old Firebase app (its timestamp); makes re-imports idempotent.
  legacyId    String?           @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([year, sequence])
  @@index([date, year, sequence])
  @@index([customerId])
  @@map("service")
}

/// A device attached to a service. A device attached to any service cannot be deleted.
model ServiceDevice {
  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  deviceId  String  @db.Uuid
  device    Device  @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  /// Keeps the devices in the order they were attached.
  position  Int

  @@id([serviceId, deviceId])
  @@index([deviceId])
  @@map("service_device")
}

/// The last sequence number handed out per year (ADR-0003).
model ServiceNumberCounter {
  year Int @id
  last Int

  @@map("service_number_counter")
}

/// Whether a service line is work performed or a device sold (ADR-0004).
enum LineType {
  WORK
  SALE
}

/// One priced row on a service: a work line refers to an action, a sale line to a device (see GLOSSARY.md, ADR-0004).
model ServiceLine {
  id        String   @id @default(uuid()) @db.Uuid
  serviceId String   @db.Uuid
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type      LineType
  /// Set on work lines only (enforced by a check constraint).
  actionId  String?  @db.Uuid
  action    Action?  @relation(fields: [actionId], references: [id], onDelete: Restrict)
  /// Set on sale lines only (enforced by a check constraint).
  deviceId  String?  @db.Uuid
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  /// The action's or device's name when the line was added, so later renames leave old lines alone.
  label     String
  quantity  Int
  /// In whole RSD; starts as the action's price on a work line, but may differ.
  unitPrice Int
  /// Orders the lines within their service.
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId, position])
  @@index([actionId])
  @@index([deviceId])
  @@map("service_line")
}

/// What a log entry records (see GLOSSARY.md: Log entry).
enum LogEntryType {
  NOTE
  STATUS_CHANGE
  LEGACY_REMARK
}

/// One item in a service's internal log; never shown to the customer (see GLOSSARY.md).
model ServiceLogEntry {
  id         String       @id @default(uuid()) @db.Uuid
  serviceId  String       @db.Uuid
  service    Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type       LogEntryType
  /// A note's or legacy remark's text; null on a status change (enforced by a check constraint).
  text       String?
  /// Set on status changes only (enforced by a check constraint).
  fromStatus Status?
  toStatus   Status?
  /// The staff member who wrote the note or changed the status; null on a legacy remark.
  authorId   String?
  author     User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([serviceId, createdAt])
  @@index([authorId])
  @@map("service_log_entry")
}
