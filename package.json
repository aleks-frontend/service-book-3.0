{
  "name": "service-book",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @servicebook/schemas",
    "dev:backend": "npm run dev -w @servicebook/backend",
    "dev:admin-panel": "npm run dev -w @servicebook/admin-panel",
    "build": "npm run build -w @servicebook/schemas && npm run build -w @servicebook/admin-panel && npm run build -w @servicebook/backend",
    "start": "npm run start -w @servicebook/backend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.11.0"
  }
}
